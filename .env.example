# Copy to .env.local (development) or set as environment variables on the server.

# Initial admin password. Used for the FIRST sign-in only: after that the admin
# changes it from Dashboard → Account, and this value no longer signs anyone in.
ADMIN_PASSWORD=change-me

# Secret used to sign admin sessions. Set a long random value in production,
# e.g. the output of: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, ADMIN_PASSWORD is used as the signing key.
SESSION_SECRET=

# Public address of the site (for link previews), e.g. https://alumni.example.org
APP_URL=

# Optional: where the SQLite database lives (default data/alumni.db)
# DATABASE_PATH=
